 caption='SCE Household Finance (clean)' name='federated.teamgrit0sce' /></datasources><datasource-dependencies datasource='federated.teamgrit0sce'><column caption='Avg Planned Retirement Age' datatype='real' name='[c_ret_age]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([planned_retirement_age]*[weight]) / SUM(IF NOT ISNULL([planned_retirement_age]) THEN [weight] END)' /></column><column caption='Avg Years Savings Will Last' datatype='real' name='[c_years]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([years_savings_will_last]*[weight]) / SUM(IF NOT ISNULL([years_savings_will_last]) THEN [weight] END)' /></column><column datatype='string' name='[income_group]' role='dimension' type='nominal' /><column-instance column='[income_group]' derivation='None' name='[none:income_group:nk]' pivot='key' type='nominal' /><column-instance column='[c_ret_age]' derivation='User' name='[usr:c_ret_age:qk]' pivot='key' type='quantitative' /><column-instance column='[c_years]' derivation='User' name='[usr:c_years:qk]' pivot='key' type='quantitative' /></datasource-dependencies><filter class='categorical' column='[federated.teamgrit0sce].[none:income_group:nk]'><groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'><groupfilter function='level-members' level='[none:income_group:nk]' /><groupfilter function='member' level='[none:income_group:nk]' member='%null%' /></groupfilter></filter><aggregation value='true' /></view><style /><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class='Bar' /></pane></panes><rows>([federated.teamgrit0sce].[usr:c_ret_age:qk] / [federated.teamgrit0sce].[usr:c_years:qk])</rows><cols>[federated.teamgrit0sce].[none:income_group:nk]</cols></table></worksheet></worksheets><dashboards><dashboard name='RQ1 Dashboard - Income, Saving &amp; Shocks'><style /><size maxheight='850' maxwidth='1300' minheight='850' minwidth='1300' /><zones><zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'><zone h='7000' id='2' type-v2='text' w='100000' x='0' y='0'><formatted-text><run bold='true' fontsize='20'>RQ1: Income, saving vs. debt, and shocks</run><run>Æ&#10;</run><run fontcolor='#52514e' fontsize='11'>Net savers rise from 15% to 62% with income; a large income drop or health decline cuts saving at every income level.</run></formatted-text></zone><zone h='88000' id='3' name='RQ1 Saving by Income' w='50000' x='0' y='7000' /><zone h='88000' id='4' name='RQ1 Shock Impact' w='50000' x='50000' y='7000' /><zone h='5000' id='5' type-v2='text' w='100000' x='0' y='95000'><formatted-text><run fontcolor='#8a8984' fontsize='8'>Source: Survey of Consumer Expectations, © 2013-2019 Federal Reserve Bank of New York (FRBNY). Team Grit analysis; survey-weighted.</run></formatted-text></zone></zone></zones></dashboard><dashboard name='RQ2 Dashboard - Housing Debt &amp; Credit'><style /><size maxheight='850' maxwidth='1300' minheight='850' minwidth='1300' /><zones><zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'><zone h='7000' id='2' type-v2='text' w='100000' x='0' y='0'><formatted-text><run bold='true' fontsize='20'>RQ2: Housing debt, other debt, and credit perception</run><run>Æ&#10;</run><run fontcolor='#52514e' fontsize='11'>Bigger mortgages bring more consumer debt in dollars; self-rated credit below 620 means ~7x the expected bankruptcy risk.</run></formatted-text></zone><zone h='88000' id='3' name='RQ2 Debt Mix by Mortgage' w='50000' x='0' y='7000' /><zone h='88000' id='4' name='RQ2 Credit vs Distress' w='50000' x='50000' y='7000' /><zone h='5000' id='5' type-v2='text' w='100000' x='0' y='95000'><formatted-text><run fontcolor='#8a8984' fontsize='8'>Source: Survey of Consumer Expectations, © 2013-2019 Federal Reserve Bank of New York (FRBNY). Team Grit analysis; survey-weighted.</run></formatted-text></zone></zone></zones></dashboard><dashboard name='RQ3 Dashboard - Savings, Income &amp; Retirement'><style /><size maxheight='850' maxwidth='1300' minheight='850' minwidth='1300' /><zones><zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'><zone h='7000' id='2' type-v2='text' w='100000' x='0' y='0'><formatted-text><run bold='true' fontsize='20'>RQ3: Savings, income, and retirement plans</run><run>Æ&#10;</run><run fontcolor='#52514e' fontsize='11'>Higher income and savings mean an earlier planned retirement and savings that last longer (non-retired household heads).</run></formatted-text></zone><zone h='88000' id='3' name='RQ3 Retirement by Savings' w='50000' x='0' y='7000' /><zone h='88000' id='4' name='RQ3 Retirement by Income' w='50000' x='50000' y='7000' /><zone h='5000' id='5' type-v2='text' w='100000' x='0' y='95000'><formatted-text><run fontcolor='#8a8984' fontsize='8'>Source: Survey of Consumer Expectations, © 2013-2019 Federal Reserve Bank of New York (FRBNY). Team Grit analysis; survey-weighted.</run></formatted-text></zone></zone></zones></dashboard></dashboards><windows><window class='worksheet' name='RQ1 Saving by Income'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards></window><window class='worksheet' name='RQ1 Shock Impact'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards></window><window class='worksheet' name='RQ2 Debt Mix by Mortgage'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' 