><column datatype='real' name='[pct_legal]' role='measure' type='quantitative' /><column datatype='real' name='[amt_legal]' role='measure' type='quantitative' /><column datatype='real' name='[homeowner]' role='measure' type='quantitative' /><column datatype='real' name='[housing_debt]' role='measure' type='quantitative' /><column datatype='string' name='[housing_debt_tier]' role='dimension' type='nominal' /><column datatype='real' name='[credit_rating]' role='dimension' type='nominal' /><column datatype='real' name='[pct_chance_bankruptcy_12m]' role='measure' type='quantitative' /><column datatype='real' name='[considered_bankruptcy_12m]' role='measure' type='quantitative' /><column datatype='real' name='[late_3mo_housing_12m]' role='measure' type='quantitative' /><column datatype='real' name='[pct_chance_can_raise_2k]' role='measure' type='quantitative' /><column datatype='string' name='[source_of_2k]' role='dimension' type='nominal' /><column datatype='real' name='[large_income_drop]' role='measure' type='quantitative' /><column datatype='real' name='[health_shock]' role='measure' type='quantitative' /><column datatype='string' name='[shock_group]' role='dimension' type='nominal' /><column datatype='real' name='[withdrew_due_to_health]' role='measure' type='quantitative' /><column datatype='integer' name='[retired]' role='measure' type='quantitative' /><column datatype='real' name='[planned_retirement_age]' role='measure' type='quantitative' /><column datatype='real' name='[years_savings_will_last]' role='measure' type='quantitative' /><column datatype='real' name='[expected_savings_at_retirement]' role='measure' type='quantitative' /><column datatype='string' name='[savings_adequacy]' role='dimension' type='nominal' /><column caption='Share of Households (weighted)' datatype='real' default-format='p0%' name='[c_share_behavior]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM(IF NOT ISNULL([saving_behavior]) THEN [weight] END) / MIN({FIXED [income_group]: SUM(IF NOT ISNULL([saving_behavior]) THEN [weight] END)})' /></column><column caption='Net Saver Rate' datatype='real' default-format='p0%' name='[c_net_saver]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([net_saver]*[weight]) / SUM(IF NOT ISNULL([net_saver]) THEN [weight] END)' /></column><column caption='Shock Status' datatype='string' name='[c_shock_status]' role='dimension' type='nominal'><calculation class='tableau' formula='IF [large_income_drop]=1 OR [health_shock]=1 THEN &apos;Income drop or health decline&apos; ELSEIF [large_income_drop]=0 AND [health_shock]=0 THEN &apos;No shock&apos; END' /></column><column caption='Avg Credit Card Debt' datatype='real' default-format='c0' name='[c_avg_cc]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([amt_credit_card]*[weight]) / SUM(IF NOT ISNULL([amt_credit_card]) THEN [weight] END)' /></column><column caption='Avg Auto Loan Debt' datatype='real' default-format='c0' name='[c_avg_auto]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([amt_auto]*[weight]) / SUM(IF NOT ISNULL([amt_auto]) THEN [weight] END)' /></column><column caption='Avg Student Loan Debt' datatype='real' default-format='c0' name='[c_avg_student]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([amt_student]*[weight]) / SUM(IF NOT ISNULL([amt_student]) THEN [weight] END)' /></column><column caption='Avg Medical Debt' datatype='real' default-format='c0' name='[c_avg_medical]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([amt_medical]*[weight]) / SUM(IF NOT ISNULL([amt_medical]) THEN [weight] END)' /></column><column caption='Avg Self-Rated % Chance of Bankruptcy (12m)' datatype='real' default-format='p0.0%' name='[c_bankrupt]' role='measure' type='quantitative'><calculation class='tableau' formula='(SUM([pct_chance_bankruptcy_12m]*[weight]) / SUM(IF NOT ISNULL([pct_chance_bankruptcy_12m]) THEN [weight] END)) / 100' /></column><column caption='Avg % Chance Could Raise $2,000' datatype='real' default-format='p0%' name='[c_raise2k]' role='measure' type='quantitative'><calculation class='tableau' formula='(SUM([pct_chance_can_raise_2k]*[weight]) / SUM(IF NOT ISNULL([pct_chance_can_raise_2k]) THEN [weight] END)) / 100' /></column><column caption='Avg Planned Retirement Age' datatype='real' default-format='n0.0' name='[c_ret_age]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([planned_retirement_age]*[weight]) / SUM(IF NOT ISNULL([planned_retirement_age]) THEN [weight] END)' /></column><column caption='Avg Years Savings Will Last' datatype='real' default-format='n0' name='[c_years]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([years_savings_will_last]*[weight]) / SUM(IF NOT ISNULL([years_savings_will_last]) THEN [weight] END)' /></column></datasource></datasources><worksheets><worksheet name='RQ1 Saving by Income'><layout-options><title><formatted-text><run bold='true' fontsize='14'>Higher income turns households into net savers</run></formatted-text></title></layout-options><table><view><datasources><datasource caption='SCE Household Finance (clean)' name='federated.teamgrit0sce' /></datasources><datasource-dependencies datasource='federated.teamgrit0sce'><column caption='Share of Households (weighted)' datatype='real' name='[c_share_behavior]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM(IF NOT ISNULL([saving_behavior]) THEN [weight] END) / MIN({FIXED [income_group]: SUM(IF NOT ISNULL([saving_behavior]) THEN [weight] END)})' /></column><column datatype='string' name='[income_group]' role='dimension' type='nominal' /><column datatype='string' name='[saving_behavior]' role='dimension' type='nominal' /><column-instance column='[income_group]' derivation='None' name='[none:income_group:nk]' pivot='key' type='nominal' /><column-instance column='[saving_behav