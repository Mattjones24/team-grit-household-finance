      <simple-id uuid='{09A513AB-15CD-4437-9D71-7E78D2CF83B0}' />
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='RQ1 Dashboard - Income, Saving &amp; Shocks'>
      <style />
      <size maxheight='850' maxwidth='1300' minheight='850' minwidth='1300' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='8000' id='2' type-v2='text' w='100000' x='0' y='0'>
            <formatted-text>
              <run bold='true' fontsize='20'>RQ1: Income, saving vs. debt, and shocks</run>
              <run>Æ&#10;</run>
              <run fontcolor='#52514e' fontsize='11'>Net savers rise from 15% to 62% with income; a large income drop or health decline cuts saving at every income level.</run>
            </formatted-text>
          </zone>
          <zone h='80000' id='3' name='RQ1 Saving by Income' w='50000' x='0' y='8000' />
          <zone h='80000' id='4' name='RQ1 Shock Impact' w='50000' x='50000' y='8000' />
          <zone h='8000' id='5' name='RQ1 Saving by Income' pane-specification-id='0' param='[federated.teamgrit0sce].[none:saving_behavior:nk]' type-v2='color' w='50000' x='0' y='88000' />
          <zone h='8000' id='6' name='RQ1 Shock Impact' pane-specification-id='0' param='[federated.teamgrit0sce].[none:c_shock_status:nk]' type-v2='color' w='50000' x='50000' y='88000' />
          <zone h='4000' id='7' type-v2='text' w='100000' x='0' y='96000'>
            <formatted-text>
              <run fontcolor='#8a8984' fontsize='8'>Source: Survey of Consumer Expectations, © 2013-2019 Federal Reserve Bank of New York (FRBNY). Team Grit analysis; survey-weighted.</run>
            </formatted-text>
          </zone>
        </zone>
      </zones>
      <simple-id uuid='{51CBA4EA-56D4-40DE-A61C-AF011BEDBA43}' />
    </dashboard>
    <dashboard name='RQ2 Dashboard - Housing Debt &amp; Credit'>
      <style />
      <size maxheight='850' maxwidth='1300' minheight='850' minwidth='1300' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='8000' id='2' type-v2='text' w='100000' x='0' y='0'>
            <formatted-text>
              <run bold='true' fontsize='20'>RQ2: Housing debt, other debt, and credit perception</run>
              <run>Æ&#10;</run>
              <run fontcolor='#52514e' fontsize='11'>Bigger mortgages bring more consumer debt in dollars; self-rated credit below 620 means ~7x the expected bankruptcy risk.</run>
            </formatted-text>
          </zone>
          <zone h='88000' id='3' name='RQ2 Debt Mix by Mortgage' w='55000' x='0' y='8000' />
          <zone h='44000' id='4' name='RQ2 Bankruptcy Risk by Credit' w='45000' x='55000' y='8000' />
          <zone h='44000' id='5' name='RQ2 Cushion by Credit' w='45000' x='55000' y='52000' />
          <zone h='4000' id='6' type-v2='text' w='100000' x='0' y='96000'>
            <formatted-text>
              <run fontcolor='#8a8984' fontsize='8'>Source: Survey of Consumer Expectations, © 2013-2019 Federal Reserve Bank of New York (FRBNY). Team Grit analysis; survey-weighted.</run>
            </formatted-text>
          </zone>
        </zone>
      </zones>
      <simple-id uuid='{09E98932-FC6D-480E-987B-F3BEE6F7D46F}' />
    </dashboard>
    <dashboard name='RQ3 Dashboard - Savings, Income &amp; Retirement'>
      <style />
      <size maxheight='850' maxwidth='1300' minheight='850' minwidth='1300' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='8000' id='2' type-v2='text' w='100000' x='0' y='0'>
            <formatted-text>
              <run bold='true' fontsize='20'>RQ3: Savings, income, and retirement plans</run>
              <run>Æ&#10;</run>
              <run fontcolor='#52514e' fontsize='11'>Higher income: retire ~3 years earlier. More savings: savings expected to last 2.5x longer (non-retired household heads).</run>
            </formatted-text>
          </zone>
          <zone h='44000' id='3' name='RQ3 Retirement Age by Income' w='50000' x='0' y='8000' />
          <zone h='44000' id='4' name='RQ3 Retirement Age by Savings' w='50000' x='50000' y='8000' />
          <zone h='44000' id='5' name='RQ3 Years Savings Last by Income' w='50000' x='0' y='52000' />
          <zone h='44000' id='6' name='RQ3 Years Savings Last by Savings' w='50000' x='50000' y='52000' />
          <zone h='4000' id='7' type-v2='text' w='100000' x='0' y='96000'>
            <formatted-text>
              <run fontcolor='#8a8984' fontsize='8'>Source: Survey of Consumer Expectations, © 2013-2019 Federal Reserve Bank of New York (FRBNY). Team Grit analysis; survey-weighted.</run>
            </formatted-text>
          </zone>
        </zone>
      </zones>
      <simple-id uuid='{D5E2305C-286E-4BB8-89D3-65282BA0FE4D}' />
    </dashboard>
  </dashboards>
