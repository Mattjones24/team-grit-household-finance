    <worksheet name='RQ2 Bankruptcy Risk by Credit'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='14'>Self-rated chance of bankruptcy in the next 12 months (%)</run>
          </formatted-text>
        </title>
