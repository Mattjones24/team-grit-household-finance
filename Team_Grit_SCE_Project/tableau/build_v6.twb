    <worksheet name='RQ2 Debt Mix by Mortgage'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='14'>Bigger mortgages come with more consumer debt (avg $ per indebted household)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='SCE Household Finance (clean)' name='federated.teamgrit0sce' />
          </datasources>
          <datasource-dependencies datasource='federated.teamgrit0sce'>
            <column datatype='real' name='[amt_auto]' role='measure' type='quantitative' />
            <column datatype='real' name='[amt_credit_card]' role='measure' type='quantitative' />
            <column datatype='real' name='[amt_medical]' role='measure' type='quantitative' />
            <column datatype='real' name='[amt_student]' role='measure' type='quantitative' />
            <column caption='Avg Auto Loan Debt ($)' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[c_avg_auto]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([amt_auto]*[weight]) / SUM(IF NOT ISNULL([amt_auto]) THEN [weight] END), -2)' />
            </column>
            <column caption='Avg Credit Card Debt ($)' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[c_avg_cc]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([amt_credit_card]*[weight]) / SUM(IF NOT ISNULL([amt_credit_card]) THEN [weight] END), -2)' />
            </column>
            <column caption='Avg Medical Debt ($)' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[c_avg_medical]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([amt_medical]*[weight]) / SUM(IF NOT ISNULL([amt_medical]) THEN [weight] END), -2)' />
            </column>
            <column caption='Avg Student Loan Debt ($)' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[c_avg_student]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([amt_student]*[weight]) / SUM(IF NOT ISNULL([amt_student]) THEN [weight] END), -2)' />
            </column>
            <column caption='Housing Debt' datatype='string' name='[housing_debt_tier]' role='dimension' type='nominal' />
            <column-instance column='[housing_debt_tier]' derivation='None' name='[none:housing_debt_tier:nk]' pivot='key' type='nominal' />
            <column-instance column='[c_avg_auto]' derivation='User' name='[usr:c_avg_auto:qk]' pivot='key' type='quantitative' />
            <column-instance column='[c_avg_cc]' derivation='User' name='[usr:c_avg_cc:qk]' pivot='key' type='quantitative' />
            <column-instance column='[c_avg_medical]' derivation='User' name='[usr:c_avg_medical:qk]' pivot='key' type='quantitative' />
            <column-instance column='[c_avg_student]' derivation='User' name='[usr:c_avg_student:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[weight]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.teamgrit0sce].[none:housing_debt_tier:nk]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:housing_debt_tier:nk]' />
              <groupfilter function='member' level='[none:housing_debt_tier:nk]' member='%null%' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.teamgrit0sce].[none:housing_debt_tier:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>([federated.teamgrit0sce].[usr:c_avg_cc:qk] + ([federated.teamgrit0sce].[usr:c_avg_auto:qk] + ([federated.teamgrit0sce].[usr:c_avg_student:qk] + [federated.teamgrit0sce].[usr:c_avg_medical:qk])))</rows>
        <cols>[federated.teamgrit0sce].[none:housing_debt_tier:nk]</cols>
      </table>
      <simple-id uuid='{EAA0CE8A-A396-443B-B833-ACAC5538AD9B}' />
    </worksheet>
