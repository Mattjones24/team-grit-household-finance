            <column-instance column='[c_share_behavior]' derivation='User' name='[usr:c_share_behavior:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[weight]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.teamgrit0sce].[none:income_group:nk]'>
