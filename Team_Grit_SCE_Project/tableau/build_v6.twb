              <groupfilter function='level-members' level='[none:income_group:nk]' />
              <groupfilter function='member' level='[none:income_group:nk]' member='%null%' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.teamgrit0sce].[none:saving_behavior:nk]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:saving_behavior:nk]' />
              <groupfilter function='member' level='[none:saving_behavior:nk]' member='%null%' />
