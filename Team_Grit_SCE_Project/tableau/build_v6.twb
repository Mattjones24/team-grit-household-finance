      <aliases enabled='yes' />
      <column caption='Migrated Data' datatype='table' name='[__tableau_internal_object_id__].[Migrated Data]' role='measure' type='quantitative' />
      <column caption='Avg Auto Loan Debt ($)' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[c_avg_auto]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([amt_auto]*[weight]) / SUM(IF NOT ISNULL([amt_auto]) THEN [weight] END), -2)' />
      </column>
      <column caption='Avg Credit Card Debt ($)' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[c_avg_cc]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([amt_credit_card]*[weight]) / SUM(IF NOT ISNULL([amt_credit_card]) THEN [weight] END), -2)' />
      </column>
      <column caption='Avg Medical Debt ($)' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[c_avg_medical]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([amt_medical]*[weight]) / SUM(IF NOT ISNULL([amt_medical]) THEN [weight] END), -2)' />
      </column>
      <column caption='Avg Student Loan Debt ($)' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[c_avg_student]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([amt_student]*[weight]) / SUM(IF NOT ISNULL([amt_student]) THEN [weight] END), -2)' />
      </column>
      <column caption='Avg Self-Rated Chance of Bankruptcy, 12m (%)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[c_bankrupt]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([pct_chance_bankruptcy_12m]*[weight]) / SUM(IF NOT ISNULL([pct_chance_bankruptcy_12m]) THEN [weight] END), 1)' />
      </column>
      <column caption='Net Saver Rate (%)' datatype='real' default-format='n#,##0;-#,##0' name='[c_net_saver]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(100 * SUM([net_saver]*[weight]) / SUM(IF NOT ISNULL([net_saver]) THEN [weight] END), 0)' />
      </column>
      <column caption='Avg Chance Could Raise $2,000 in a Month (%)' datatype='real' default-format='n#,##0;-#,##0' name='[c_raise2k]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([pct_chance_can_raise_2k]*[weight]) / SUM(IF NOT ISNULL([pct_chance_can_raise_2k]) THEN [weight] END), 0)' />
      </column>
      <column caption='Avg Planned Retirement Age' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[c_ret_age]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([planned_retirement_age]*[weight]) / SUM(IF NOT ISNULL([planned_retirement_age]) THEN [weight] END), 1)' />
      </column>
      <column caption='Share of Households (%)' datatype='real' default-format='n#,##0;-#,##0' name='[c_share_behavior]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(100 * SUM(IF NOT ISNULL([saving_behavior]) THEN [weight] END) / MIN({FIXED [income_group]: SUM(IF NOT ISNULL([saving_behavior]) THEN [weight] END)}), 0)' />
      </column>
      <column caption='Shock Status' datatype='string' name='[c_shock_status]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [large_income_drop]=1 OR [health_shock]=1 THEN &apos;Income drop or health decline&apos; ELSEIF [large_income_drop]=0 AND [health_shock]=0 THEN &apos;No shock&apos; END' />
      </column>
      <column caption='Avg Years Savings Will Last' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[c_years]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([years_savings_will_last]*[weight]) / SUM(IF NOT ISNULL([years_savings_will_last]) THEN [weight] END), 1)' />
      </column>
      <column caption='Self-Reported Credit Score' datatype='string' name='[credit_rating]' role='dimension' type='nominal' />
      <column caption='Housing Debt' datatype='string' name='[housing_debt_tier]' role='dimension' type='nominal' />
      <column caption='Household Income' datatype='string' name='[income_group]' role='dimension' type='nominal' />
      <column caption='Saving Behavior (last 12 months)' datatype='string' name='[saving_behavior]' role='dimension' type='nominal' />
      <column caption='Total Savings (liquid + 401k + IRA)' datatype='string' name='[savings_tier]' role='dimension' type='nominal' />
      <column datatype='integer' name='[survey_year]' role='dimension' type='ordinal' />
      <column datatype='integer' name='[userid]' role='dimension' type='ordinal' />
