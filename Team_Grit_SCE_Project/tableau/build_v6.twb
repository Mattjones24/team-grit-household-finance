              <calculation class='tableau' formula='ROUND(SUM([pct_chance_bankruptcy_12m]*[weight]) / SUM(IF NOT ISNULL([pct_chance_bankruptcy_12m]) THEN [weight] END), 1)' />
            </column>
            <column caption='Self-Reported Credit Score' datatype='string' name='[credit_rating]' role='dimension' type='nominal' />
            <column-instance column='[credit_rating]' derivation='None' name='[none:credit_rating:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[pct_chance_bankruptcy_12m]' role='measure' type='quantitative' />
            <column-instance column='[c_bankrupt]' derivation='User' name='[usr:c_bankrupt:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[weight]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.teamgrit0sce].[none:credit_rating:nk]'>
