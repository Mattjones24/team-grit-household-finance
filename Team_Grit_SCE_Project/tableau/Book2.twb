      <aliases enabled='yes' />
      <column caption='Number Of Records' datatype='integer' name='[Calculation_6789824156807168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='NOP' datatype='integer' name='[Calculation_6789824156971009]' role='measure' type='quantitative'>
