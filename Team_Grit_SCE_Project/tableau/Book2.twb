      <column caption='Length Of Stay' datatype='real' name='[Calculation_6789824157155330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(DAY([Check In Time])[Discharge Datetime])' />
      </column>
      <column caption='WTcolorcode' datatype='string' name='[Calculation_6789824867827715]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MEDIAN([Wait Time Min])&gt;60 THEN &apos;Over Target&apos; ELSE &apos;Below Target&apos; END' />
