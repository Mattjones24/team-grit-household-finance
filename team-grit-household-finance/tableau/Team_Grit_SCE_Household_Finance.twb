<dashboards><dashboard name='RQ1 Income, Saving &amp; Shocks'><style /><size maxheight='800' maxwidth='1300' minheight='800' minwidth='1300' sizing-mode='fixed' />
<zones><zone h='100000' id='15' type-v2='layout-basic' w='100000' x='0' y='0'><zone h='9000' id='11' type-v2='text' w='100000' x='0' y='0'><formatted-text><run bold='true' fontsize='20'>RQ1 — Income decides who saves; shocks erase much of that advantage</run><run>&#10;</run><run fontcolor='#52514e' fontsize='11'>Saving behavior by household income (left) and net-saver rate with vs. without an income or health shock (right).</run></formatted-text></zone><zone h='87000' id='12' name='1 Saving by Income' w='55000' x='0' y='9000' /><zone h='87000' id='13' name='2 Shocks and Saving' w='45000' x='55000' y='9000' /><zone h='4000' id='14' type-v2='text' w='100000' x='0' y='96000'><formatted-text><run fontcolor='#8a8984' fontsize='8'>Source: Survey of Consumer Expectations, © 2013-2019 Federal Reserve Bank of New York (FRBNY). SCE Household Finance survey, 2014-2019 waves; survey-weighted. Team Grit.</run></formatted-text></zone></zone></zones><simple-id uuid='{92225833-1111-4000-8000-000000000000}' /></dashboard><dashboard name='RQ2 Housing Debt &amp; Credit'><style /><size maxheight='800' maxwidth='1300' minheight='800' minwidth='1300' sizing-mode='fixed' />
<zones><zone h='100000' id='21' type-v2='layout-basic' w='100000' x='0' y='0'><zone h='9000' id='16' type-v2='text' w='100000' x='0' y='0'><formatted-text><run bold='true' fontsize='20'>RQ2 — Bigger mortgages bring more consumer debt; weak credit signals default risk</run><run>&#10;</run><run fontcolor='#52514e' fontsize='11'>Average non-housing debt by type and mortgage tier (left); self-rated credit vs expected bankruptcy risk and $2k cushion (right).</run></formatted-text></zone><zone h='87000' id='17' name='3 Debt Mix by Mortgage' w='50000' x='0' y='9000' /><zone h='43500' id='18' name='4 Credit vs Bankruptcy Risk' w='50000' x='50000' y='9000' /><zone h='43500' id='19' name='5 Credit vs $2k Cushion' w='50000' x='50000' y='52500' /><zone h='4000' id='20' type-v2='text' w='100000' x='0' y='96000'><formatted-text><run fontcolor='#8a8984' fontsize='8'>Source: Survey of Consumer Expectations, © 2013-2019 Federal Reserve Bank of New York (FRBNY). SCE Household Finance survey, 2014-2019 waves; survey-weighted. Team Grit.</run></formatted-text></zone></zone></zones><simple-id uuid='{25396441-1111-4000-8000-000000000000}' /></dashboard><dashboard name='RQ3 Savings, Income &amp; Retirement'><style /><size maxheight='800' maxwidth='1300' minheight='800' minwidth='1300' sizing-mode='fixed' />
<zones><zone h='100000' id='27' type-v2='layout-basic' w='100000' x='0' y='0'><zone h='9000' id='22' type-v2='text' w='100000' x='0' y='0'><formatted-text><run bold='true' fontsize='20'>RQ3 — Money buys an earlier and longer-lasting retirement</run><run>&#10;</run><run fontcolor='#52514e' fontsize='11'>Non-retired household heads. Total savings = liquid savings + 401(k)/DC plans + IRAs.</run></formatted-text></zone><zone h='87000' id='23' name='6 Retirement Age by Income' w='33333' x='0' y='9000' /><zone h='87000' id='24' name='7 Years Savings Last' w='33333' x='33333' y='9000' /><zone h='87000' id='25' name='8 Retirement Shortfall' w='33334' x='66666' y='9000' /><zone h='4000' id='26' type-v2='text' w='100000' x='0' y='96000'><formatted-text><run fontcolor='#8a8984' fontsize='8'>Source: Survey of Consumer Expectations, © 2013-2019 Federal Reserve Bank of New York (FRBNY). SCE Household Finance survey, 2014-2019 waves; survey-weighted. Team Grit.</run></formatted-text></zone></zone></zones><simple-id uuid='{93215159-1111-4000-8000-000000000000}' /></dashboard></dashboards>
