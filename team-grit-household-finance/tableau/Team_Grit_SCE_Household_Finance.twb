<columns character-set='UTF-8' header='yes' locale='en_US' separator=','><column datatype='integer' name='userid' ordinal='0' /><column datatype='integer' name='survey_year' ordinal='1' /><column datatype='real' name='weight' ordinal='2' /><column datatype='real' name='hh_income' ordinal='3' /><column datatype='string' name='income_group' ordinal='4' /><column datatype='string' name='saving_behavior' ordinal='5' /><column datatype='real' name='net_saver' ordinal='6' /><column datatype='real' name='net_dissaver' ordinal='7' /><column datatype='real' name='no_savings_account' ordinal='8' /><column datatype='real' name='liquid_savings' ordinal='9' /><column datatype='real' name='dc_retirement_balance' ordinal='10' /><column datatype='real' name='ira_balance' ordinal='11' /><column datatype='real' name='total_fin_assets' ordinal='12' /><column datatype='string' name='savings_tier' ordinal='13' /><column datatype='real' name='non_housing_debt' ordinal='14' /><column datatype='real' name='has_non_housing_debt' ordinal='15' /><column datatype='real' name='pct_credit_card' ordinal='16' /><column datatype='real' name='amt_credit_card' ordinal='17' /><column datatype='real' name='pct_auto' ordinal='18' /><column datatype='real' name='amt_auto' ordinal='19' /><column datatype='real' name='pct_student' ordinal='20' /><column datatype='real' name='amt_student' ordinal='21' /><column datatype='real' name='pct_other_loans' ordinal='22' /><column datatype='real' name='amt_other_loans' ordinal='23' /><column datatype='real' name='pct_medical' ordinal='24' /><column datatype='real' name='amt_medical' ordinal='25' /><column datatype='real' name='pct_legal' ordinal='26' /><column datatype='real' name='amt_legal' ordinal='27' /><column datatype='real' name='homeowner' ordinal='28' /><column datatype='real' name='housing_debt' ordinal='29' /><column datatype='string' name='housing_debt_tier' ordinal='30' /><column datatype='string' name='credit_rating' ordinal='31' /><column datatype='real' name='pct_chance_bankruptcy_12m' ordinal='32' /><column datatype='real' name='considered_bankruptcy_12m' ordinal='33' /><column datatype='real' name='late_3mo_housing_12m' ordinal='34' /><column datatype='real' name='pct_chance_can_raise_2k' ordinal='35' /><column datatype='string' name='source_of_2k' ordinal='36' /><column datatype='real' name='large_income_drop' ordinal='37' /><column datatype='real' name='health_shock' ordinal='38' /><column datatype='string' name='shock_group' ordinal='39' /><column datatype='real' name='withdrew_due_to_health' ordinal='40' /><column datatype='integer' name='retired' ordinal='41' /><column datatype='real' name='planned_retirement_age' ordinal='42' /><column datatype='real' name='years_savings_will_last' ordinal='43' /><column datatype='real' name='expected_savings_at_retirement' ordinal='44' /><column datatype='string' name='savings_adequacy' ordinal='45' /></columns></relation></connection>
<aliases enabled='yes' /><column caption='Weighted Share' datatype='real' default-format='p0%' name='[C_share]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM(IIF(ISNULL([saving_behavior]),0,[weight])) / MIN({FIXED [income_group]: SUM(IIF(ISNULL([saving_behavior]),0,[weight]))})' /></column><column caption='Net Saver % (weighted)' datatype='real' default-format='p0%' name='[C_saver]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([net_saver]*[weight]) / SUM(IIF(ISNULL([net_saver]),0,[weight]))' /></column><column caption='Shock Status' datatype='string' name='[C_shock]' role='dimension' type='nominal'><calculation class='tableau' formula='IF ISNULL([shock_group]) THEN NULL ELSEIF [shock_group]=&#x27;No shock&#x27; THEN &#x27;No shock&#x27; ELSE &#x27;Income drop or health decline&#x27; END' /></column><column caption='Valid RQ1' datatype='boolean' name='[C_v1]' role='dimension' type='nominal'><calculation class='tableau' formula='NOT ISNULL([income_group]) AND NOT ISNULL([saving_behavior])' /></column><column caption='Valid Shock' datatype='boolean' name='[C_v2]' role='dimension' type='nominal'><calculation class='tableau' formula='NOT ISNULL([income_group]) AND NOT ISNULL([shock_group]) AND NOT ISNULL([net_saver])' /></column><column caption='Valid Debt Mix' datatype='boolean' name='[C_v3]' role='dimension' type='nominal'><calculation class='tableau' formula='[non_housing_debt]&gt;0 AND NOT ISNULL([pct_credit_card]) AND NOT ISNULL([housing_debt_tier])' /></column><column caption='Known Credit' datatype='boolean' name='[C_v4]' role='dimension' type='nominal'><calculation class='tableau' formula='NOT ISNULL([credit_rating]) AND [credit_rating]&lt;&gt;&quot;6. Don&#x27;t know&quot;' /></column><column caption='Credit cards' datatype='real' default-format='c&quot;$&quot;#,##0' name='[C_cc]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([amt_credit_card]*[weight]) / SUM(IIF(ISNULL([amt_credit_card]),0,[weight]))' /></column><column caption='Auto loans' datatype='real' default-format='c&quot;$&quot;#,##0' name='[C_auto]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([amt_auto]*[weight]) / SUM(IIF(ISNULL([amt_auto]),0,[weight]))' /></column><column caption='Student loans' datatype='real' default-format='c&quot;$&quot;#,##0' name='[C_stu]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([amt_student]*[weight]) / SUM(IIF(ISNULL([amt_student]),0,[weight]))' /></column><column caption='Medical bills' datatype='real' default-format='c&quot;$&quot;#,##0' name='[C_med]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([amt_medical]*[weight]) / SUM(IIF(ISNULL([amt_medical]),0,[weight]))' /></column><column caption='Other &amp; legal' datatype='real' default-format='c&quot;$&quot;#,##0' name='[C_oth]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM((ZN([amt_other_loans])+ZN([amt_legal]))*[weight]) / SUM(IIF(ISNULL([amt_credit_card]),0,[weight]))' /></column><column caption='Avg % chance of bankruptcy (12m)' datatype='real' default-format='p0.0%' name='[C_bk]' role='measure' type='quantitative'><calculation class='tableau' formula='(SUM([pct_chance_bankruptcy_12m]*[weight]) / SUM(IIF(ISNULL([pct_chance_bankruptcy_12m]),0,[weight])))/100' /></column><column caption='Avg % chance can raise $2,000' datatype='real' default-format='p0%' name='[C_2k]' role='measure' type='quantitative'><calculation class='tableau' formula='(SUM([pct_chance_can_raise_2k]*[weight]) / SUM(IIF(ISNULL([pct_chance_can_raise_2k]),0,[weight])))/100' /></column><column caption='Avg planned retirement age' datatype='real' default-format='n#,##0.0' name='[C_age]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([planned_retirement_age]*[weight]) / SUM(IIF(ISNULL([planned_retirement_age]),0,[weight]))' /></column><column caption='Avg years savings will last' datatype='real' default-format='n#,##0.0' name='[C_yrs]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([years_savings_will_last]*[weight]) / SUM(IIF(ISNULL([years_savings_will_last]),0,[weight]))' /></column><column caption='% expecting &#x27;too little&#x27; saved' datatype='real' default-format='p0%' name='[C_short]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM(IIF([savings_adequacy]=&#x27;Too little&#x27;,[weight],0)) / SUM(IIF(ISNULL([savings_adequacy]),0,[weight]))' /></column><column caption='Has Income Group' datatype='boolean' name='[C_vinc]' role='dimension' type='nominal'><calculation class='tableau' formula='NOT ISNULL([income_group])' /></column><column caption='Has Savings Tier' datatype='boolean' name='[C_vsav]' role='dimension' type='nominal'><calculation class='tableau' formula='NOT ISNULL([savings_tier])' /></column></datasource></datasources>
